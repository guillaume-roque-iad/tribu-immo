// Contacts du simulateur : tableau de candidatures existant + alerte interne.
var LEADS_SHEET_ID = '158E65XNtEGMwRTpd_lA94P39jfFdPTMnAoUbZhhgFfI';
var LEADS_TAB = 'Réponses au formulaire 1';
function leadTexte_(v,n) { var s=String(v==null?'':v).trim().slice(0,n||2000); return /^[=+@\-]/.test(s)?"'"+s:s; }
function leadColonnes_(sh) {
  var h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0], out={};
  ['ID formulaire simulateur','Source formulaire','Responsable formulaire','Alerte formulaire envoyée le','Erreur alerte formulaire'].forEach(function(k){
    var i=h.indexOf(k); if(i<0){i=h.length;h.push(k);if(i+1>sh.getMaxColumns())sh.insertColumnsAfter(sh.getMaxColumns(),i+1-sh.getMaxColumns());sh.getRange(1,i+1).setValue(k);}out[k]=i+1;
  }); return out;
}
function enregistrerLead_(p) {
  if(p.societe||p.website)return {ok:false,message:'Demande invalide.'};
  var email=String(p.email||'').trim().toLowerCase();
  if(!String(p.nom||'').trim()||!emailValide_(email)||!String(p.telephone||'').trim()||!String(p.ville||'').trim()||!p.consentement)return {ok:false,message:'Coordonnées ou consentement manquants.'};
  if(p.source_site!=='Tribu Immo'&&p.source_site!=='Team Lucky')return {ok:false,message:'Origine invalide.'};
  var ident=String(p.submission_id||'');if(!/^[a-zA-Z0-9-]{16,80}$/.test(ident))return {ok:false,message:'Identifiant absent.'};
  if(p.simulation){if(p.simulation.length>30000)return {ok:false,message:'Simulation trop volumineuse.'};JSON.parse(p.simulation);}
  var lock=LockService.getScriptLock();lock.waitLock(10000);
  try {
    var sh=SpreadsheetApp.openById(LEADS_SHEET_ID).getSheetByName(LEADS_TAB);
    if(!sh||sh.getRange(1,3).getValue()!=='Adresse email')throw Error('Tableau de candidatures non reconnu');
    var c=leadColonnes_(sh), last=sh.getLastRow();
    var found=last>1?sh.getRange(2,c['ID formulaire simulateur'],last-1,1).createTextFinder(ident).matchEntireCell(true).findNext():null;
    if(found){leadAlerteLigne_(sh,found.getRow(),c);return {ok:true,saved:true,duplicate:true};}
    var note='Origine : '+p.source_site+'\nPage : '+String(p.page||'').slice(0,2000)+'\nRéférent : '+String(p.referent||'').slice(0,200)+'\n'+String(p.message||'').slice(0,8000);
    if(p.simulation)note+='\nRéponses et résultats déclaratifs :\n'+p.simulation;
    var row=Array(sh.getLastColumn()).fill('');
    row[0]=new Date();row[1]=leadTexte_(p.nom);row[2]=email;row[3]="'"+String(p.telephone).trim().slice(0,100);row[4]=leadTexte_(p.ville);
    row[6]=leadTexte_(p.situation);row[7]=leadTexte_(note,45000);row[8]=leadTexte_(p.disponibilite);row[10]=leadTexte_(p.pays);row[11]='Nouveau';
    // Autorisation donnée par Guillaume pour les contacts de ce tableau ; tout refus explicite prime.
    var refus=/^(non|no|false|0)$/i.test(String(p.newsletter==null?'':p.newsletter));row[23]=refus?'Non':'Oui';
    row[c['ID formulaire simulateur']-1]=ident;row[c['Source formulaire']-1]=p.source_site;
    row[c['Responsable formulaire']-1]=p.source_site==='Team Lucky'?'Élodie Cimiotta':'Guillaume Roque';
    sh.appendRow(row);SpreadsheetApp.flush();var n=sh.getLastRow();
    sh.getRange(n,24).setNote('Source : formulaire '+p.source_site+'. Consentement déclaré : '+String(p.consentement).slice(0,2000)+'. Inscription selon autorisation de Guillaume ; les refus et désabonnements restent prioritaires.');
    var sent=leadAlerteLigne_(sh,n,c);
    return {ok:true,saved:true,notificationSent:sent};
  } finally {lock.releaseLock();}
}

function leadMessageHtml_(lead, lien) {
  function h(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  var tel=String(lead.tel||'').replace(/^'/,''), email=String(lead.email||'');
  function champ(label,value,href){var v=value||'Non renseigné';return '<tr><td style="padding:12px 18px;border-bottom:1px solid #e7eef2"><div style="font-size:12px;color:#536174;margin-bottom:5px">'+h(label)+'</div><div style="font-size:16px;line-height:1.5;color:#263746;overflow-wrap:anywhere">'+(href?'<a style="color:#006B9A;text-decoration:underline" href="'+h(href)+'">'+h(v)+'</a>':h(v))+'</div></td></tr>';}
  var html='<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head><body style="margin:0;background:#f3f7f9;color:#263746;font-family:Montserrat,Helvetica,Arial,sans-serif">'+
    '<div style="display:none;max-height:0;overflow:hidden">Nouveau contact : '+h(lead.nom)+' — ses coordonnées sont disponibles.</div>'+
    '<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f3f7f9"><tr><td align="center" style="padding:24px 12px">'+
    '<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background:white;border:1px solid #e0e8ed;border-radius:18px;overflow:hidden">'+
    '<tr><td style="padding:20px 26px;background:#ffffff;border-bottom:4px solid #00B4EC"><table role="presentation" cellspacing="0" cellpadding="0"><tr><td style="padding-right:28px"><img src="cid:iadLogo" width="65" alt="iad immobilier" style="display:block;width:65px;height:auto;border:0"></td><td><img src="cid:tribuLogo" width="112" alt="Tribu Immo" style="display:block;width:112px;height:auto;border:0"></td></tr></table></td></tr>'+
    '<tr><td style="padding:28px 26px 20px"><div style="font-size:11px;letter-spacing:1.5px;font-weight:700;color:#006B9A">SIMULATEUR · NOUVEAU CONTACT</div><h1 style="font-size:26px;line-height:1.25;margin:10px 0 12px;font-weight:700;color:#263746">'+h(lead.nom)+'</h1><p style="font-size:15px;line-height:1.6;margin:0">Cette personne a rempli le formulaire du simulateur. Retrouvez ses coordonnées pour la recontacter.</p></td></tr>'+
    '<tr><td style="padding:0 26px"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#E9FCFF;border:1px solid #cceaf0;border-radius:12px">'+
    champ('Nom et prénom',lead.nom)+champ('Téléphone',tel,tel?'tel:'+tel.replace(/[^+0-9]/g,''):null)+champ('Adresse email',email,email?'mailto:'+email:null)+champ('Ville / secteur',lead.ville)+champ('Situation professionnelle',lead.situation)+champ('Disponibilité',lead.disponibilite)+
    '</table></td></tr><tr><td style="padding:18px 26px;font-size:12px;line-height:1.8;color:#536174">Origine : <strong>'+h(lead.source)+'</strong><br>Responsable : '+h(lead.responsable)+'<br>Demande reçue le '+h(lead.date)+'</td></tr>'+
    '<tr><td style="padding:4px 26px 28px"><a href="'+h(lien)+'" style="display:inline-block;padding:15px 24px;border-radius:50px;background:#00B4EC;color:#000000;font-size:14px;line-height:1.4;font-weight:700;font-style:italic;text-decoration:none">Voir le contact dans le tableau</a><p style="font-size:12px;line-height:1.6;color:#536174;margin:16px 0 0">Vous pouvez répondre directement à cet email pour contacter cette personne.</p></td></tr>'+
    '<tr><td style="padding:16px 26px;background:#f8fafb;border-top:1px solid #e7eef2;font-size:11px;line-height:1.7;color:#536174">Notification interne · iad Tribu Immo<br>Guillaume Roque · guillaume.roque@iadfrance.fr · 06 62 10 83 96</td></tr></table></td></tr></table></body></html>';
  return {htmlBody:html,inlineImages:{tribuLogo:Utilities.newBlob(Utilities.base64Decode(''),'image/png','tribu-immo.png'),iadLogo:Utilities.newBlob(Utilities.base64Decode(''),'image/png','iad-immobilier.png')}};
}
function leadAlerteLigne_(sh,n,c) {
  if(sh.getRange(n,c['Alerte formulaire envoyée le']).getValue())return true;
  var r=sh.getRange(n,1,1,sh.getLastColumn()).getValues()[0];
  try {
    var lien='https://docs.google.com/spreadsheets/d/'+LEADS_SHEET_ID+'/edit#gid='+sh.getSheetId()+'&range=A'+n+':AF'+n;
    var lead={nom:r[1],email:r[2],tel:r[3],ville:r[4],situation:r[6],disponibilite:r[8],source:r[c['Source formulaire']-1],responsable:r[c['Responsable formulaire']-1],date:Utilities.formatDate(new Date(r[0]),'Europe/Paris','dd/MM/yyyy à HH:mm')};
    var mail=leadMessageHtml_(lead,lien);
    mail.to=EMAIL_NOTIF;mail.replyTo=lead.email;mail.name='Tribu Immo — Simulateur';mail.subject='Nouveau contact simulateur — '+lead.nom;
    mail.body='Nouveau contact simulateur\n\nNom : '+lead.nom+'\nTéléphone : '+String(lead.tel).replace(/^'/,'')+'\nEmail : '+lead.email+'\nVille : '+lead.ville+'\nSituation : '+lead.situation+'\nDisponibilité : '+lead.disponibilite+'\nOrigine : '+lead.source+'\nReçu le : '+lead.date+'\n\nVoir le contact : '+lien;
    MailApp.sendEmail(mail);
    sh.getRange(n,c['Alerte formulaire envoyée le']).setValue(new Date());sh.getRange(n,c['Erreur alerte formulaire']).clearContent();return true;
  } catch(err){sh.getRange(n,c['Erreur alerte formulaire']).setValue(String(err.message).slice(0,1000));return false;}
}
function reprendreAlertesSimulateur() {
  var lock=LockService.getScriptLock();if(!lock.tryLock(1000))return;
  try {var sh=SpreadsheetApp.openById(LEADS_SHEET_ID).getSheetByName(LEADS_TAB), c=leadColonnes_(sh), n=sh.getLastRow();if(n<2)return;
    var rows=sh.getRange(2,1,n-1,sh.getLastColumn()).getValues(), count=0;
    for(var i=0;i<rows.length&&count<20;i++)if(rows[i][c['ID formulaire simulateur']-1]&&!rows[i][c['Alerte formulaire envoyée le']-1]){leadAlerteLigne_(sh,i+2,c);count++;}
  }finally{lock.releaseLock();}
}
function installerAlertesSimulateur() {
  var sh=SpreadsheetApp.openById(LEADS_SHEET_ID).getSheetByName(LEADS_TAB);leadColonnes_(sh);
  console.log('Alertes simulateur actives vers '+EMAIL_NOTIF+' ; tableau candidatures existant.');
}
function testerAlerteSimulateur() {
  var lead={nom:'Contact de démonstration',email:EMAIL_NOTIF,tel:'06 62 10 83 96',ville:'Narbonne',situation:'Exemple : conseiller immobilier',disponibilite:'Exemple : en fin de journée',source:'Tribu Immo',responsable:'Guillaume Roque',date:Utilities.formatDate(new Date(),'Europe/Paris','dd/MM/yyyy à HH:mm')};
  var mail=leadMessageHtml_(lead,'https://docs.google.com/spreadsheets/d/'+LEADS_SHEET_ID+'/edit');
  mail.to=EMAIL_NOTIF;mail.replyTo=EMAIL_NOTIF;mail.name='Tribu Immo — Simulateur';mail.subject='TEST HTML — nouveau contact simulateur Tribu Immo';mail.body='Email de démonstration du nouveau modèle HTML avec logos. Coordonnées de test : Guillaume Roque, '+EMAIL_NOTIF+', 06 62 10 83 96. Aucun candidat créé.';
  MailApp.sendEmail(mail);console.log('Email HTML avec logos intégrés envoyé à '+EMAIL_NOTIF+' ; aucun candidat créé.');
}
